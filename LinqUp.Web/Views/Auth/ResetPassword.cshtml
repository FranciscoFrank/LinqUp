@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "uk";
}

<div class="auth-card">
    <div class="auth-card-header">
        <h1 class="auth-card-title" data-i18n="auth.resetPasswordTitle">@(culture == "uk" ? "Новий пароль" : "New Password")</h1>
        <p class="auth-card-subtitle" data-i18n="auth.resetPasswordSubtitle">
            @(culture == "uk" ? "Введіть новий надійний пароль для вашого акаунту" : "Enter a new secure password for your account")
        </p>
    </div>

    <div id="reset-alert" class="alert alert-danger alert-with-icon"></div>

    <div id="reset-success" style="display: none;" class="auth-success-card">
        <div class="auth-success-icon" style="text-align: center; margin-bottom: var(--space-md);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-success-base)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
        </div>
        <p class="auth-card-subtitle" id="reset-success-text" style="text-align: center; margin-bottom: var(--space-lg);">
            @(culture == "uk" ? "Пароль успішно змінено! Тепер ви можете увійти." : "Password reset successfully! You can now log in.")
        </p>
        <a href="/@culture/auth/login" class="btn btn-primary btn-block" style="text-align: center;" data-i18n="auth.login">
            @(culture == "uk" ? "Перейти до входу" : "Go to login")
        </a>
    </div>

    <form id="reset-form" novalidate>
        <partial name="Components/_TextField" model='new TextFieldModel { Id = "password", Name = "password", Type = "password", Label = "Новий пароль", LabelKey = "auth.newPassword", Placeholder = (culture == "en" ? "At least 8 characters" : "Мінімум 8 символів"), PlaceholderKey = "auth.passwordRegisterPlaceholder", Required = true, AutoComplete = "new-password", MaxLength = 100, Icon = "lock", PasswordToggle = true }' />

        <!-- Password Checklist -->
        <div class="password-checklist" id="password-checklist">
            <div class="checklist-title" data-i18n="auth.passwordRequirements">Вимоги до надійності пароля:</div>
            <ul class="checklist-items">
                <li class="req-item" id="req-length">
                    <span class="req-item-icon"></span>
                    <span data-i18n="auth.reqMinLength">Щонайменше 8 символів</span>
                </li>
                <li class="req-item" id="req-uppercase">
                    <span class="req-item-icon"></span>
                    <span data-i18n="auth.reqUppercase">Велика літера (A-Z)</span>
                </li>
                <li class="req-item" id="req-number">
                    <span class="req-item-icon"></span>
                    <span data-i18n="auth.reqNumber">Принаймні одна цифра (0-9)</span>
                </li>
                <li class="req-item" id="req-special">
                    <span class="req-item-icon"></span>
                    <span data-i18n="auth.reqSpecial">Спецсимвол (!@@#$%^&*)</span>
                </li>
            </ul>
        </div>

        <partial name="Components/_TextField" model='new TextFieldModel { Id = "confirmPassword", Name = "confirmPassword", Type = "password", Label = "Повторіть пароль", LabelKey = "auth.confirmPassword", Placeholder = (culture == "en" ? "Repeat password" : "Введіть пароль ще раз"), PlaceholderKey = "auth.confirmPasswordPlaceholder", Required = true, AutoComplete = "new-password", MaxLength = 100, Icon = "lock", PasswordToggle = true }' />

        <div style="margin-top: var(--space-lg);">
            <partial name="Components/_Button" model='new ButtonModel { Id = "reset-submit", Text = (culture == "uk" ? "Зберегти новий пароль" : "Save new password"), TextKey = "auth.saveNewPassword", Type = "submit", Variant = "primary", FullWidth = true }' />
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/pages/reset-password.js" asp-append-version="true"></script>
}
