@{
    ViewData["Title"] = "Register";
    Layout = "_AuthLayout";
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "uk";
}

<div class="auth-card">
    <div class="auth-card-header">
        <h1 class="auth-card-title" data-i18n="auth.registerTitle">Реєстрація</h1>
        <p class="auth-card-subtitle" data-i18n="auth.registerSubtitle">Створіть акаунт LinqUp</p>
    </div>

    <!-- Social Login Stub Buttons -->
    <div class="auth-social-grid">
        <button type="button" class="btn-social" id="google-register-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
            </svg>
            <span data-i18n="auth.continueWithGoogle">Google</span>
        </button>
        <button type="button" class="btn-social" id="github-register-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span data-i18n="auth.continueWithGithub">GitHub</span>
        </button>
    </div>

    <div class="auth-divider">
        <span data-i18n="auth.socialOr">або</span>
    </div>

    <div id="register-alert" class="alert alert-danger alert-with-icon"></div>

    <form id="register-form" novalidate>
        <div class="form-grid">
            <partial name="Components/_TextField" model='new TextFieldModel { Id = "firstName", Name = "firstName", Label = "Ім’я", LabelKey = "auth.firstName", Placeholder = (culture == "en" ? "Alex" : "Олександр"), PlaceholderKey = "auth.firstNamePlaceholder", Required = true, AutoComplete = "given-name", Icon = "user" }' />
            <partial name="Components/_TextField" model='new TextFieldModel { Id = "lastName", Name = "lastName", Label = "Прізвище", LabelKey = "auth.lastName", Placeholder = (culture == "en" ? "Smith" : "Шевченко"), PlaceholderKey = "auth.lastNamePlaceholder", Required = true, AutoComplete = "family-name", Icon = "user" }' />
        </div>
        <partial name="Components/_TextField" model='new TextFieldModel { Id = "email", Name = "email", Type = "email", Label = "Email", LabelKey = "auth.email", Placeholder = "name@example.com", PlaceholderKey = "auth.emailPlaceholder", Required = true, AutoComplete = "email", Icon = "email" }' />
        <partial name="Components/_TextField" model='new TextFieldModel { Id = "password", Name = "password", Type = "password", Label = "Пароль", LabelKey = "auth.password", Placeholder = (culture == "en" ? "At least 8 characters" : "Мінімум 8 символів"), PlaceholderKey = "auth.passwordRegisterPlaceholder", Required = true, AutoComplete = "new-password", MaxLength = 100, Icon = "lock", PasswordToggle = true }' />

        <!-- Dynamic Password Strength & Requirements Checklist -->
        <div class="password-checklist" id="password-checklist">
            <div class="checklist-title" data-i18n="auth.passwordRequirements">Вимоги до надійності пароля:</div>
            <ul class="checklist-items">
                <li class="req-item" id="req-length">
                    <span class="req-item-icon"></span>
                    <span data-i18n="auth.reqMinLength">Щонайменше 8 символів</span>
                </li>
                <li class="req-item" id="req-uppercase">
                    <span class="req-item-icon"></span>
                    <span data-i18n="auth.reqUppercase">Велика літера (A-Z)</span>
                </li>
                <li class="req-item" id="req-number">
                    <span class="req-item-icon"></span>
                    <span data-i18n="auth.reqNumber">Принаймні одна цифра (0-9)</span>
                </li>
                <li class="req-item" id="req-special">
                    <span class="req-item-icon"></span>
                    <span data-i18n="auth.reqSpecial">Спеціальний символ (!@@#$%^&*)</span>
                </li>
            </ul>
        </div>

        <p class="auth-legal-notice">
            <span data-i18n="auth.termsAgreement">Реєструючись, ви погоджуєтеся з</span>
            <a href="/@culture/Home/Terms" target="_blank" data-i18n="auth.termsLink">Умовами використання</a>
            <span data-i18n="auth.andText">та</span>
            <a href="/@culture/Home/Privacy" target="_blank" data-i18n="auth.privacyLink">Політикою конфіденційності</a>.
        </p>

        <partial name="Components/_Button" model='new ButtonModel { Id = "register-submit", Text = "Зареєструватись", TextKey = "auth.registerSubmit", Type = "submit", Variant = "primary", FullWidth = true }' />
    </form>

    <p class="auth-switch">
        <span data-i18n="auth.haveAccount">Вже є акаунт?</span>
        <a href="#" id="login-link" data-i18n="auth.loginLink">Увійти</a>
    </p>
</div>

@section Scripts {
    <script src="~/js/pages/register.js" asp-append-version="true"></script>
}
