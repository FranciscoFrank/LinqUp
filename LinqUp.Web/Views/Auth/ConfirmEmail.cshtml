@{
    ViewData["Title"] = "Confirm Email";
    Layout = "_AuthLayout";
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "uk";
}

<div class="auth-card">
    <div class="auth-card-header">
        <h1 class="auth-card-title" data-i18n="auth.confirmEmailTitle">@(culture == "uk" ? "Підтвердження Email" : "Confirm Email")</h1>
        <p class="auth-card-subtitle" id="confirm-status-subtitle">
            @(culture == "uk" ? "Перевіряємо ваш токен підтвердження..." : "Verifying your confirmation token...")
        </p>
    </div>

    <div id="confirm-loading" style="text-align: center; padding: var(--space-xl) 0;">
        <div class="spinner" style="margin: 0 auto 16px auto;"></div>
        <p style="color: var(--color-text-muted); font-size: 14px;">@(culture == "uk" ? "Будь ласка, зачекайте..." : "Please wait...")</p>
    </div>

    <div id="confirm-alert" class="alert alert-danger alert-with-icon" style="display: none;"></div>

    <div id="confirm-success" style="display: none;" class="auth-success-card">
        <div class="auth-success-icon" style="text-align: center; margin-bottom: var(--space-md);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-success-base)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
        </div>
        <p class="auth-card-subtitle" style="text-align: center; margin-bottom: var(--space-lg);" data-i18n="auth.confirmEmailSuccess">
            @(culture == "uk" ? "Вашу електронну адресу успішно підтверджено!" : "Your email has been successfully verified!")
        </p>
        <a href="/@culture/auth/login" class="btn btn-primary btn-block" style="text-align: center;" data-i18n="auth.login">
            @(culture == "uk" ? "Перейти до входу" : "Go to login")
        </a>
    </div>

    <div id="confirm-retry" style="display: none; text-align: center; margin-top: var(--space-lg);">
        <a href="/@culture/auth/login" class="btn btn-secondary btn-block" data-i18n="auth.backToLogin">
            @(culture == "uk" ? "Повернутися до входу" : "Back to login")
        </a>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/confirm-email.js" asp-append-version="true"></script>
}
