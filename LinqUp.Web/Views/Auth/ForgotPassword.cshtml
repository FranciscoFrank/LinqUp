@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "uk";
}

<div class="auth-card">
    <div class="auth-card-header">
        <h1 class="auth-card-title" data-i18n="auth.forgotPasswordTitle">@(culture == "uk" ? "Відновлення паролю" : "Reset Password")</h1>
        <p class="auth-card-subtitle" data-i18n="auth.forgotPasswordSubtitle">
            @(culture == "uk" ? "Введіть ваш email, і ми надішлемо посилання для відновлення доступу" : "Enter your email and we'll send you a link to reset your password")
        </p>
    </div>

    <div id="forgot-alert" class="alert alert-danger alert-with-icon"></div>

    <div id="forgot-success" style="display: none;" class="auth-success-card">
        <div class="auth-success-icon" style="text-align: center; margin-bottom: var(--space-md);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
        </div>
        <p class="auth-card-subtitle" id="forgot-success-text" style="text-align: center; margin-bottom: var(--space-lg);">
            @(culture == "uk" ? "Лист з посиланням надіслано! Будь ласка, перевірте поштову скриньку." : "Email sent! Please check your inbox.")
        </p>
        <a href="/@culture/auth/login" class="btn btn-secondary btn-block" style="text-align: center;" data-i18n="auth.backToLogin">
            @(culture == "uk" ? "Повернутися до входу" : "Back to login")
        </a>
    </div>

    <form id="forgot-form" novalidate>
        <partial name="Components/_TextField" model='new TextFieldModel { Id = "email", Name = "email", Type = "email", Label = "Email", LabelKey = "auth.email", Placeholder = "name@example.com", PlaceholderKey = "auth.emailPlaceholder", Required = true, AutoComplete = "email", Icon = "email" }' />

        <div style="margin-top: var(--space-lg);">
            <partial name="Components/_Button" model='new ButtonModel { Id = "forgot-submit", Text = (culture == "uk" ? "Надіслати посилання" : "Send reset link"), TextKey = "auth.sendResetLink", Type = "submit", Variant = "primary", FullWidth = true }' />
        </div>
    </form>

    <p class="auth-switch" id="forgot-back-wrap">
        <a href="/@culture/auth/login" id="back-login-link" data-i18n="auth.backToLogin">
            @(culture == "uk" ? "← Повернутися до входу" : "← Back to login")
        </a>
    </p>
</div>

@section Scripts {
    <script src="~/js/pages/forgot-password.js" asp-append-version="true"></script>
}
