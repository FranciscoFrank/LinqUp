@model LinqUp.Web.Models.Components.CheckboxModel

<div class="field field-inline">
    <label class="checkbox-label" for="@Model.Id">
        <input
            class="checkbox"
            id="@Model.Id"
            name="@Model.Name"
            type="checkbox"
            @(Model.Checked ? "checked" : "") />
        <span data-i18n="@Model.LabelKey">@Model.Label</span>
    </label>
    @if (!string.IsNullOrEmpty(Model.HelpText))
    {
        <p class="field-help">@Model.HelpText</p>
    }
</div>
