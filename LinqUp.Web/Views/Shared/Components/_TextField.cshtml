@model LinqUp.Web.Models.Components.TextFieldModel

<div class="field">
    <label class="field-label" for="@Model.Id" data-i18n="@Model.LabelKey">
        @Model.Label
        @if (Model.Required)
        {
            <span class="field-required" aria-hidden="true">*</span>
        }
    </label>
    @if (!string.IsNullOrEmpty(Model.Icon) || Model.PasswordToggle)
    {
        <div class="input-wrapper @(!string.IsNullOrEmpty(Model.Icon) ? "has-icon" : "") @(Model.PasswordToggle ? "has-toggle" : "")">
            @if (Model.Icon == "email")
            {
                <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            }
            else if (Model.Icon == "lock")
            {
                <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            }
            else if (Model.Icon == "user")
            {
                <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            }
            else if (Model.Icon == "shield")
            {
                <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            }
            else if (Model.Icon == "key")
            {
                <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 2l-2 2m-1.5 1.5L14 9l-3-3 1.5-1.5M3 21l9-9"></path><circle cx="7.5" cy="16.5" r="4.5"></circle></svg>
            }

            <input
                class="input"
                id="@Model.Id"
                name="@Model.Name"
                type="@Model.Type"
                placeholder="@Model.Placeholder"
                data-i18n-placeholder="@Model.PlaceholderKey"
                value="@Model.Value"
                autocomplete="@Model.AutoComplete"
                maxlength="@Model.MaxLength"
                @(Model.Required ? "required" : "") />

            @if (Model.PasswordToggle)
            {
                <button type="button" class="btn-password-toggle" data-target="@Model.Id" aria-label="Показати пароль" title="Показати пароль">
                    <svg class="icon-eye" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg class="icon-eye-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                        <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                </button>
            }
        </div>
    }
    else
    {
        <input
            class="input"
            id="@Model.Id"
            name="@Model.Name"
            type="@Model.Type"
            placeholder="@Model.Placeholder"
            data-i18n-placeholder="@Model.PlaceholderKey"
            value="@Model.Value"
            autocomplete="@Model.AutoComplete"
            maxlength="@Model.MaxLength"
            @(Model.Required ? "required" : "") />
    }
    @if (!string.IsNullOrEmpty(Model.HelpText))
    {
        <p class="field-help" data-i18n="@Model.HelpTextKey">@Model.HelpText</p>
    }
    <p class="field-error" data-error-for="@Model.Id"></p>
</div>
