<section class="section-block" id="how-it-works">
    <div class="container">
        <div class="section-heading">
            <h2 data-i18n="howItWorks.title">Як це працює</h2>
        </div>
        <div class="steps">
            <div class="step-card">
                <div class="step-card-watermark" aria-hidden="true">
                    <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="18" height="12" x="3" y="4" rx="2"/>
                        <line x1="2" x2="22" y1="20" y2="20"/>
                        <path d="M7 8h4M7 11h2"/>
                    </svg>
                </div>
                <div class="step-number">1</div>
                <h3 data-i18n="howItWorks.step1Title">Створи профіль</h3>
                <p data-i18n="howItWorks.step1Text">Напиши кілька слів про себе та додай зручні способи контакту.</p>
            </div>

            <div class="step-connector step-connector--straight" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none">
                    <path d="M 4 16 H 26 M 19 9 L 26 16 L 19 23" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>

            <div class="step-card">
                <div class="step-card-watermark" aria-hidden="true">
                    <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="18" cy="5" r="3"/>
                        <circle cx="6" cy="12" r="3"/>
                        <circle cx="18" cy="19" r="3"/>
                        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
                    </svg>
                </div>
                <div class="step-number">2</div>
                <h3 data-i18n="howItWorks.step2Title">Познач скіли</h3>
                <p data-i18n="howItWorks.step2Text">Обери технології зі списку або додай свої.</p>
            </div>

            <div class="step-connector step-connector--fork" aria-hidden="true">
                <svg viewBox="0 0 48 270" fill="none">
                    <!-- Stem from Step 2 -->
                    <line x1="2" y1="135" x2="16" y2="135" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                    <circle cx="16" cy="135" r="3.5" fill="currentColor" />
                    <!-- Upper branch -->
                    <path d="M 16 135 V 72 C 16 62, 22 60, 30 60 H 42" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                    <polyline points="35 53 42 60 35 67" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                    <!-- Lower branch -->
                    <path d="M 16 135 V 198 C 16 208, 22 210, 30 210 H 42" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                    <polyline points="35 203 42 210 35 217" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>

            <div class="step-branch">
                <div class="step-card step-card--branch">
                    <div class="step-card-watermark" aria-hidden="true">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                    </div>
                    <div class="step-number">3</div>
                    <h3 data-i18n="howItWorks.step3FindTitle">Знайди команду</h3>
                    <p data-i18n="howItWorks.step3FindText">Переглядай проєкти й приєднуйся до тих, хто шукає саме тебе.</p>
                </div>

                <div class="step-branch-divider">
                    <span class="step-branch-badge" data-i18n="howItWorks.orBadge">або</span>
                </div>

                <div class="step-card step-card--branch">
                    <div class="step-card-watermark" aria-hidden="true">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
                            <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
                        </svg>
                    </div>
                    <div class="step-number">3</div>
                    <h3 data-i18n="howItWorks.step3CreateTitle">Створи команду</h3>
                    <p data-i18n="howItWorks.step3CreateText">Опиши свій проєкт, визнач потрібний стек і збирай однодумців.</p>
                </div>
            </div>
        </div>
    </div>
</section>

