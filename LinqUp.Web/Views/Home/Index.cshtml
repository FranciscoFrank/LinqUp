<section class="section-block home-faq-section" id="faq">
    <div class="home-faq-ambient-glow" aria-hidden="true"></div>
    <div class="home-faq-bg-grid" aria-hidden="true"></div>
    
    <svg class="home-faq-constellation home-faq-constellation--left" viewBox="0 0 220 220" fill="none" aria-hidden="true">
        <line x1="30" y1="30" x2="110" y2="70" stroke="currentColor" stroke-dasharray="4 4" />
        <line x1="110" y1="70" x2="180" y2="40" stroke="currentColor" />
        <line x1="110" y1="70" x2="80" y2="150" stroke="currentColor" />
        <line x1="80" y1="150" x2="160" y2="180" stroke="currentColor" stroke-dasharray="3 3" />
