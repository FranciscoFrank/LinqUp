                    <div id="contact-error" class="alert alert-danger"></div>

                    <form id="contact-form" novalidate>
                        <div class="form-grid">
                            <partial name="Components/_TextField" model='new TextFieldModel { Id = "contact-name", Name = "name", Label = "Ім’я", LabelKey = "contact.formName", Icon = "user", Placeholder = "Олексій", PlaceholderKey = "contact.formNamePlaceholder", Required = true }' />
                            <partial name="Components/_TextField" model='new TextFieldModel { Id = "contact-email", Name = "email", Type = "email", Label = "Email", LabelKey = "contact.formEmail", Icon = "email", Placeholder = "alex@university.edu", PlaceholderKey = "contact.formEmailPlaceholder", Required = true }' />
                        </div>
                        <partial name="Components/_TextField" model='new TextFieldModel { Id = "contact-subject", Name = "subject", Label = "Тема", LabelKey = "contact.formSubject", Placeholder = "Співпраця або питання", PlaceholderKey = "contact.formSubjectPlaceholder", Required = true }' />
                        <partial name="Components/_TextArea" model='new TextAreaModel { Id = "contact-message", Name = "message", Label = "Повідомлення", LabelKey = "contact.formMessage", Rows = 4, Placeholder = "Опишіть деталі вашого запиту...", PlaceholderKey = "contact.formMessagePlaceholder", Required = true }' />
                        <partial name="Components/_Button" model='new ButtonModel { Id = "contact-submit", Text = "Надіслати повідомлення", TextKey = "contact.formSubmit", Type = "submit", Variant = "primary", FullWidth = true }' />
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/pages/home.js"></script>
}
