@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "uk";
    ViewData["Title"] = culture == "uk" ? "Умови використання" : "Terms of Use";
    ViewData["MetaDescription"] = culture == "uk" 
        ? "Офіційні умови використання та правила платформи LinqUp. Дізнайтеся про права користувачів, інтелектуальну власність та правила участі в командах."
        : "Official Terms of Use and Community Guidelines for the LinqUp platform. Learn about user rights, intellectual property ownership, and team collaboration rules.";
}

<div class="legal-page">
    <div class="legal-hero">
        <div class="container">
            <nav class="legal-breadcrumbs" aria-label="Breadcrumb">
                <a href="/@culture/">@(culture == "uk" ? "Головна" : "Home")</a>
                <span class="legal-breadcrumbs-separator" aria-hidden="true">/</span>
                <span aria-current="page">@(culture == "uk" ? "Умови використання" : "Terms of Use")</span>
            </nav>

            <h1 class="legal-hero-title">
                @(culture == "uk" ? "Умови використання платформи" : "Terms of Use")
            </h1>
            <p class="legal-hero-lead">
                @(culture == "uk"
                    ? "Будь ласка, уважно ознайомтеся з цими Умовами перед використанням платформи LinqUp. Тут чітко закріплено ваші права, правила спільноти та абсолютне право власності на всі створені вами проєкти."
                    : "Please read these Terms carefully before using LinqUp. They define your rights, community rules, and guarantee your 100% intellectual property ownership over all your projects.")
