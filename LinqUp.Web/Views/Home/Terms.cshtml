            <a href="#section-2" class="legal-pill-link">02. @(culture == "uk" ? "Вимоги" : "Eligibility")</a>
            <a href="#section-3" class="legal-pill-link">03. @(culture == "uk" ? "Платформа" : "Services")</a>
            <a href="#section-4" class="legal-pill-link">04. @(culture == "uk" ? "Правила" : "Rules")</a>
            <a href="#section-5" class="legal-pill-link">05. @(culture == "uk" ? "Власність" : "IP Rights")</a>
