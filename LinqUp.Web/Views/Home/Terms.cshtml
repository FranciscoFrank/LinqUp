    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Print action
            const printBtn = document.getElementById('btn-print-doc');
            if (printBtn) {
                printBtn.addEventListener('click', () => window.print());
            }

            // Copy Link action
            const copyBtn = document.getElementById('btn-copy-link');
            const copyText = document.getElementById('btn-copy-text');
            if (copyBtn && copyText) {
                copyBtn.addEventListener('click', async () => {
                    try {
                        await navigator.clipboard.writeText(window.location.href);
                        const originalText = copyText.textContent;
                        copyText.textContent = '@(culture == "uk" ? "Скопійовано!" : "Copied!")';
                        setTimeout(() => { copyText.textContent = originalText; }, 2200);
                    } catch (err) {
                        console.error('Failed to copy URL', err);
                    }
                });
            }

            // Scroll spy for sticky TOC
            const sections = document.querySelectorAll('.legal-section');
            const tocLinks = document.querySelectorAll('.legal-toc-link');

            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const id = entry.target.getAttribute('id');
                        tocLinks.forEach((link) => {
                            const href = link.getAttribute('href');
                            if (href === `#${id}`) {
                                link.classList.add('is-active');
                            } else {
                                link.classList.remove('is-active');
                            }
                        });
                    }
                });
            }, {
                rootMargin: '-20% 0px -70% 0px'
            });

            sections.forEach((sec) => observer.observe(sec));
        });
    </script>
